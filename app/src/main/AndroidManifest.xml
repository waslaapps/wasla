<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.waslaapps.wasla">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Wasla Game"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WaslaGame">

        <!-- MAIN ENTRY POINT -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Level select screen -->
        <activity
            android:name=".activities.LevelSelectActivity"
            android:exported="false" />

        <!-- Grid showing full crossword -->
        <activity
            android:name=".activities.GridActivity"
            android:exported="false" />

        <!-- Game screen for clue answering -->
        <activity
            android:name=".activities.GameActivity"
            android:exported="false" />
    </application>

</manifest>
